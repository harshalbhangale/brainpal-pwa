# Copy to .env.local and fill in. Never commit real secrets.
# In AWS, OPENAI_API_KEY lives in Secrets Manager, not in the environment file.

OPENAI_API_KEY=

# Model registry. No PAL may hard-code a model name; every model is addressed
# by role so routing and cost can change without touching agent code.
MODEL_ROUTER=
MODEL_BALANCED=
MODEL_REASONING=
MODEL_VISION=

# Port 5433, not 5432 — see the note in docker-compose.yml.
DATABASE_URL=postgresql://brainpal:brainpal@127.0.0.1:5433/brainpal
REDIS_URL=redis://localhost:6379

AWS_REGION=ap-southeast-2
S3_UPLOADS_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Phase 1 only: serves a mock parent session so the agent loop can be built
# before Cognito is wired. Has no effect when NODE_ENV=production.
MOCK_AUTH=true
