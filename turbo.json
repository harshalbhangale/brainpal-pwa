{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "MOCK_AUTH",
    "API_PORT",
    "LOG_LEVEL",
    "ALLOWED_ORIGINS",
    "RATE_LIMIT_MAX",
    "OPENAI_API_KEY",
    "MODEL_ROUTER",
    "MODEL_BALANCED",
    "MODEL_REASONING",
    "MODEL_VISION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
