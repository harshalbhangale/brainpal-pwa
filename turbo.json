{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "MOCK_AUTH",
    "API_PORT",
    "LOG_LEVEL",
    "ALLOWED_ORIGINS",
    "RATE_LIMIT_MAX",
    "OPENAI_API_KEY",
    "MODEL_ROUTER",
    "MODEL_BALANCED",
    "MODEL_REASONING",
    "MODEL_VISION",
    "API_HOST",
    "TRUST_PROXY",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "DATABASE_SSL_CA",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "GOOGLE_CLIENT_ID",
    "UPLOADS_BUCKET",
    "AWS_REGION",
    "WORKER_INTERVAL_MS",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
