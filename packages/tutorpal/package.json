{
  "name": "@brainpal/tutorpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.ts",
    "eval": "tsc && node --env-file-if-exists=../../.env.local evals/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1131.0",
    "@brainpal/brainpal": "workspace:*",
    "@brainpal/database": "workspace:*",
    "ai": "^7.0.100",
    "drizzle-orm": "^0.45.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
